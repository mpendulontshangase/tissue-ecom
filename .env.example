# Postgres connection string. Use Neon's pooled connection string on Vercel.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Random string, at least 32 characters. Used to sign session cookies.
AUTH_SECRET=replace-with-a-long-random-string

# First owner account. Applied by `npm run db:prepare` and by `npm run build`.
# The password is set only when the user is created. Set SEED_RESET_ADMIN_PASSWORD=true
# for one run if you need to overwrite it.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=change-me-please

# Optional. Set both to email customers when an order is updated. If either is missing, the update is still stored in the app.
RESEND_API_KEY=
EMAIL_FROM="Softmill <orders@yourdomain.com>"

# Optional. Public site URL used in email links. On Vercel, VERCEL_URL is used when this is empty.
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Optional. Set to true to reset the owner password from ADMIN_PASSWORD on the next seed.
SEED_RESET_ADMIN_PASSWORD=

# Product pictures are stored in Postgres and do not need a blob token.
# Shop name, phone, email, and social links are edited in the owner dashboard.

# Optional. These override the Yoco keys saved in Payments settings.
# YOCO_SECRET_KEY and YOCO_WEBHOOK_SECRET are never shown in the browser.
YOCO_PUBLIC_KEY=
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

# Optional. Encrypts Yoco secrets in the database. When unset, AUTH_SECRET is used.
PAYMENT_ENCRYPTION_KEY=
